
projection;
strict ( 2 );
use draft;

define behavior for ZC_Product alias Product
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action validateHierarchy;
  use action reviewHierarchyWithAI;

  use association _Hierarchy {
    create;
    with draft;
  }
}

define behavior for ZC_ProductHierarchy alias Hierarchy
{
  use update;
  use delete;

  use association _Product {
    with draft;
  }
}